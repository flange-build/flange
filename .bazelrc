# Bazel output base 持久化到项目目录，Docker volume 映射后容器重建不丢失缓存
startup --output_base=/workspace/output/bazel

# 禁用 convenience 符号链接（容器内路径在宿主机上是断链）
build --experimental_convenience_symlinks=ignore

# aarch64 交叉编译
build:aarch64 --platforms=//toolchain:aarch64_linux

# 板级配置 — Radxa Zero 3W (RK3566)
build:radxa-zero3w --platforms=//toolchain:aarch64_linux
build:radxa-zero3w --define=platform=rockchip
build:radxa-zero3w --define=board=radxa-zero3w

# 板级配置 — Neons Core3566 Nano B (RK3566)
build:neons-core3566-nanob --platforms=//toolchain:aarch64_linux
build:neons-core3566-nanob --define=platform=rockchip
build:neons-core3566-nanob --define=board=neons-core3566-nanob

# 板级配置 — TSpi RK3566
build:tspi-rk3566 --platforms=//toolchain:aarch64_linux
build:tspi-rk3566 --define=platform=rockchip
build:tspi-rk3566 --define=board=tspi-rk3566
