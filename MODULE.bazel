module(
    name = "flange",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_cc", version = "0.1.1")

register_toolchains("//toolchain:aarch64_linux_toolchain")

# 内核源码仓库（由 config_registry 驱动）
kernel = use_extension("//build:extensions.bzl", "kernel_sources")
kernel.source(board = "radxa-zero3w")
use_repo(kernel, "kernel_src_radxa_zero3w")

# Bootloader 源码仓库 + rkbin 固件仓库（由 config_registry 驱动）
bootloader = use_extension("//build:extensions.bzl", "bootloader_sources")
bootloader.source(board = "radxa-zero3w")
use_repo(bootloader, "bootloader_src_radxa_zero3w", "rkbin_rockchip")

# Rootfs 源码（ubuntu-base tarball，由 config_registry 驱动）
rootfs = use_extension("//build:extensions.bzl", "rootfs_sources")
rootfs.source(board = "radxa-zero3w")
use_repo(rootfs, "rootfs_src_radxa_zero3w")
