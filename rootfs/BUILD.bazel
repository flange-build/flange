# Rootfs 构建 — 顶层 alias + select() 路由

load("//build:rootfs_collect.bzl", "rootfs_collect")

alias(
    name = "rootfs",
    actual = select(
        {
            "//build:platform_rockchip": "//rootfs/rockchip",
        },
        no_match_error = "未指定目标平台，请使用 --config=<board> 指定板级配置（如 --config=radxa-zero3w）",
    ),
    visibility = ["//visibility:public"],
)

rootfs_collect(
    name = "collect",
    rootfs = ":rootfs",
)
