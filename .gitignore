# 构建产物（运行时产物层 + envsetup.sh 管理的便捷软链接）
/.build/
/target

# 其它输出
output/

# Bazel 符号链接
/bazel-*

# 运行时状态
.flange/

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/

# 本地 Docker Compose 覆盖（支持 local_path 挂载等个人化配置）
docker-compose.override.yml

# Obsidian 工作区配置（每人本地化，不入库）
.obsidian/

# Claude Code 本地运行时状态（.claude/commands/ 与 .claude/skills/ 仍入库）
.claude/scheduled_tasks.lock

# C/C++ app 构建临时目录（cmake/meson out-of-source builddir）
# 注意：bin/ 不能在此 ignore——对 build.system: none 的 app，bin/ 是预编译
# 产物入仓目录（如 adbd/bin/adbd-arm64）；对 cmake/meson/make 类 app，bin/
# 是构建产物（CMAKE_RUNTIME_OUTPUT_DIRECTORY），由各 app 工程内 .gitignore 自行处理
components/app/*/build/
