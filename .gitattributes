tools/macos/qdl/*/qdl filter=lfs diff=lfs merge=lfs -text
tools/linux/qdl/*/qdl filter=lfs diff=lfs merge=lfs -text
tools/*/upgrade_tool/upgrade_tool filter=lfs diff=lfs merge=lfs -text

# 厂商配置与修订记录保留原始 CRLF 和行末空格，以便核对上游摘要。
tools/*/upgrade_tool/config.ini -text whitespace=cr-at-eol
tools/*/upgrade_tool/revision.txt -text whitespace=cr-at-eol,-blank-at-eol

# UNO Q 补丁的上下文前缀允许空格加 Tab 和仅含上下文空格的行。
components/board/arduino-uno-q/patches/bootloader/*.patch whitespace=-blank-at-eol,-space-before-tab
