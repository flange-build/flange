# GUD 收帧缓冲(gud_device.c 的 s_fb / s_cbuf，各 GUD_W*GUD_H*2 字节)按 640x360
# 算共 ~900KB，超出 P4 内部 SRAM 容量。把这两个静态数组的 .bss 挪去 PSRAM，
# 与 sdkconfig.defaults 里 CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY 配合生效。
[scheme:main_extram_bss]
entries:
    bss -> extern_ram

[mapping:main_gud_buffers]
archive: libmain.a
entries:
    if ESP_ALLOW_BSS_SEG_EXTERNAL_MEMORY = y:
        gud_device:s_fb (main_extram_bss)
        gud_device:s_cbuf (main_extram_bss)
