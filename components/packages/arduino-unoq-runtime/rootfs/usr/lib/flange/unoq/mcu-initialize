#!/usr/bin/python3
"""显式初始化 MCU，绝不随 Linux 首启或 rootfs 重刷自动擦写 sketch。"""
import argparse
import os
import subprocess
from pathlib import Path

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--replace-mcu-firmware', action='store_true', help='明确允许替换 MCU 固件及 sketch')
parser.add_argument('--force', action='store_true', help='忽略当前版本初始化记录，再次替换 MCU')
args = parser.parse_args()
if not args.replace_mcu_firmware:
    parser.error('初始化会替换 MCU 固件，请明确传入 --replace-mcu-firmware')
if os.getuid() != 1000:
    raise SystemExit('请以 arduino 用户执行初始化')
identity = Path('/sys/firmware/devicetree/base/compatible').read_bytes().split(b'\0')
if b'arduino,imola' not in identity:
    raise SystemExit('板卡身份不是 UNO Q，拒绝写入 MCU')
state = Path.home() / '.local/state/flange'
marker = state / 'mcu-initialized'
version = 'arduino:zephyr:unoq 0.90.0\n'
if marker.is_file() and marker.read_text() == version and not args.force:
    print('当前版本已经初始化；保留 MCU sketch')
    raise SystemExit(0)
# CLI 1.5.1 的 bootloader action 选择 boards.txt 的 remoteocd，非 jlink 的 program.tool。
subprocess.run(['arduino-cli', '--config-file', '/home/arduino/.arduino15/arduino-cli.yaml', 'burn-bootloader', '-b', 'arduino:zephyr:unoq', '-P', 'jlink'], check=True)
state.mkdir(parents=True, exist_ok=True)
marker.write_text(version)
