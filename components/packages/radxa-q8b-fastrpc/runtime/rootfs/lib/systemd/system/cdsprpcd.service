[Unit]
Description=CDSP FastRPC daemon
Requires=radxa-q8b-fastrpc-setup.service
After=radxa-q8b-fastrpc-setup.service dev-fastrpc\x2dcdsp.device dev-fastrpc\x2dcdsp\x2dsecure.device
ConditionPathExists=|/dev/fastrpc-cdsp
ConditionPathExists=|/dev/fastrpc-cdsp-secure

[Service]
Type=exec
ExecStart=/usr/sbin/cdsprpcd
Restart=on-failure
RestartSec=5
RestartForceExitStatus=SIGTERM
