# flange_fastboot.config — 启用 fastboot gadget + hw boot0 路由
#
# mainline khadas-vim3l_defconfig 默认仅 DFU，flange flash 流程需要 fastboot
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_FASTBOOT=y
CONFIG_CMD_FASTBOOT=y
CONFIG_FASTBOOT_FLASH=y
# VIM3L 实测 mmc 设备拓扑：
#   mmc@ffe03000 → mmc0 (SDIO 卡槽，AP6398S WiFi)
#   mmc@ffe05000 → mmc1 (SD 卡槽)
#   mmc@ffe07000 → mmc2 (eMMC 14.6 GiB，含 4 MiB hw boot0/boot1)
# fastboot flash 默认操作 mmc2 user area / hw boot 分区。
CONFIG_FASTBOOT_FLASH_MMC_DEV=2
CONFIG_FASTBOOT_BUF_ADDR=0x6000000
CONFIG_FASTBOOT_BUF_SIZE=0x8000000
CONFIG_FASTBOOT_GPT_NAME="gpt"

# hw boot 分区写入支持（fastboot flash bootloader → mmc2 boot0）
# 默认 fastboot 只查 user area GPT 找 partition name "bootloader"，找不
# 到就报 "invalid partition or device"。要写 eMMC hw boot0（Amlogic
# BootROM 实际读的位置），需要：
#   CONFIG_FASTBOOT_MMC_BOOT_SUPPORT=y       开启 hw boot 分区写入路径
#   CONFIG_FASTBOOT_MMC_BOOT1_NAME="bootloader"
#     让 host 端 ``fastboot flash bootloader`` 这条命令命中 mmc2 boot0
#     （否则要 host 改写成 ``fastboot flash mmc2boot0 ...``，对开发者
#     不友好且与现有 RockchipFlashStrategy 的 "bootloader" 心智不一致）
#   CONFIG_FASTBOOT_MMC_BOOT2_NAME="bootloader2"
#     hw boot1 对应名（实际不用，仅占位避免与 BOOT1 撞名）
CONFIG_SUPPORT_EMMC_BOOT=y
CONFIG_FASTBOOT_MMC_BOOT_SUPPORT=y
CONFIG_FASTBOOT_MMC_BOOT1_NAME="bootloader"
CONFIG_FASTBOOT_MMC_BOOT2_NAME="bootloader2"

# GPT 重建：``fastboot oem format`` 让 u-boot 用自己的 gpt 子系统按实际
# eMMC 容量（14.6 GiB）构建 GPT。
#   - 早期试过 ``fastboot flash gpt <raw.img 头 17KB>``：raw.img 的 GPT
#     header 字段（FirstUsableLBA / LastUsableLBA / BackupLBA）写死的是
#     raw.img 的尺寸（~2GB），写到 14.6GB eMMC 后字段不匹配，u-boot 重读
#     GPT 校验失败，``flash boot`` 报 "Bad device specification mmc boot"。
#   - mainline u-boot ``oem format`` 子命令内部直接调
#     ``gpt write mmc <CONFIG_FASTBOOT_FLASH_MMC_DEV> $partitions``，按
#     当前 mmc dev 实际容量构建，并自动刷 secondary GPT + rescan 分区表。
#     host 端只需 ``fastboot oem format``，不传参数。
# PREBOOT 两件事：
#   (1) 设 ``partitions`` env 供 ``oem format`` 用（bootloader 在 hw boot0
#       不进 user area，仅 boot + rootfs；size=- 让 rootfs 占剩余空间）。
#   (2) **条件**进 fastboot 模式：检查 ``${boot_source}`` env 仅在板由
#       USB MaskROM 加载（pyamlboot 推 u-boot 进 DDR）时触发，避免冷启动
#       从 eMMC 起也无条件进 fastboot 卡死。
#
# ``boot_source`` 由 mainline u-boot ``arch/arm/mach-meson/board-common.c``
# 的 ``meson_set_boot_source()`` 在 ``board_late_init()`` 自动 setenv，
# 取值来自 ``meson_get_boot_device()``：
#   "usb"   —— USB ROM boot（pyamlboot 推 u-boot 到 DDR 启动）
#   "emmc"  —— eMMC 冷启动（已刷入完成后的正常 boot）
#   "sd"    —— SD 卡冷启动
# 用户体验：
#   - 首次刷入：板进 MaskROM → flange flash → pyamlboot 推 u-boot →
#     u-boot board_late_init 把 boot_source 设为 "usb" → PREBOOT 自动
#     ``fastboot usb 0`` → host 端 flange flash 直接进入分区刷写阶段，
#     **无需接串口手动敲 fastboot usb 0**。
#   - 后续冷启动：boot_source="emmc" → PREBOOT 不触发 fastboot，正常
#     走 Distroboot → extlinux.conf → Linux。
#   - 重刷工作流：用户在板上跑 ``fastboot reboot bootloader`` 让板回到
#     u-boot fastboot 模式而不重启到 Linux —— 下一次 flange flash 命中
#     host 端 fastboot 检测路径（AmlogicFlashStrategy.detect_device 已
#     支持），完全跳过 pyamlboot + USB MaskROM 拐弯，最快。
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="setenv partitions 'name=boot,size=64MiB;name=rootfs,size=-;'; if test \"${boot_source}\" = \"usb\"; then echo \"flange: USB MaskROM 加载，自动进 fastboot...\"; fastboot usb 0; fi"
CONFIG_FASTBOOT_CMD_OEM_FORMAT=y
CONFIG_CMD_GPT=y
CONFIG_RANDOM_UUID=y
