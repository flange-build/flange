#!/bin/bash
set -xeuo pipefail

MARKER="${FLANGE_ROOTFS_GROW_MARKER:-/var/lib/flange/rootfs-grown}"

if [ -e "${MARKER}" ]; then
    echo "rootfs 已扩容，跳过: ${MARKER}"
    exit 0
fi

ROOT_SOURCE="${FLANGE_ROOTFS_GROW_ROOT_SOURCE:-}"
if [ -z "${ROOT_SOURCE}" ]; then
    ROOT_SOURCE="$(findmnt -n -o SOURCE /)"
fi

if [ -z "${ROOT_SOURCE}" ]; then
    echo "无法识别当前 rootfs 块设备" >&2
    exit 1
fi

read -r PARENT_DISK PART_NUM < <(lsblk -no PKNAME,PARTN "${ROOT_SOURCE}" | head -n1)

# 兜底：某些内核/util-linux 组合下 lsblk PARTN 列不暴露（已实测：
# QCS6490 QCLINUX 6.6 BSP + util-linux 2.39 上 /dev/sda2 的 PARTN 空），
# 直接读 sysfs /sys/class/block/<dev>/partition（kernel-provided，权威）。
if [ -z "${PART_NUM:-}" ]; then
    LEAF="$(basename "${ROOT_SOURCE}")"
    if [ -r "/sys/class/block/${LEAF}/partition" ]; then
        PART_NUM="$(cat "/sys/class/block/${LEAF}/partition")"
    fi
fi

# 兜底：PKNAME 也可能空（极少见但同样从 sysfs 解析）。
if [ -z "${PARENT_DISK:-}" ]; then
    LEAF="$(basename "${ROOT_SOURCE}")"
    if [ -L "/sys/class/block/${LEAF}" ]; then
        PARENT_DISK="$(basename "$(dirname "$(readlink -f "/sys/class/block/${LEAF}")")")"
    fi
fi

if [ -z "${PARENT_DISK:-}" ] || [ -z "${PART_NUM:-}" ]; then
    echo "无法从 ${ROOT_SOURCE} 解析父磁盘和分区号" >&2
    exit 1
fi

DISK="/dev/${PARENT_DISK}"
GROWPART_LOG="$(mktemp)"
trap 'rm -f "${GROWPART_LOG}"' EXIT

sgdisk -e "${DISK}"
if ! growpart "${DISK}" "${PART_NUM}" 2>&1 | tee "${GROWPART_LOG}"; then
    if grep -q "NOCHANGE:" "${GROWPART_LOG}"; then
        echo "rootfs 分区已扩展到目标大小，继续扩展 ext4 文件系统"
    else
        exit 1
    fi
fi

if ! partx -u "${DISK}"; then
    partprobe "${DISK}"
fi

resize2fs "${ROOT_SOURCE}"

mkdir -p "$(dirname "${MARKER}")"
date -u +"%Y-%m-%dT%H:%M:%SZ" > "${MARKER}"
