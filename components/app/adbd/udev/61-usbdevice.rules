# Rockchip 等带 android_usb vendor class 的平台：每次 USB 状态变化都通过
# systemd 异步 reload，由 service cgroup 执行 usbdevice update，避免 udev
# 在事件结束后清理新拉起的 adbd。
SUBSYSTEM=="android_usb", ACTION=="change", RUN+="/usr/bin/systemctl --no-block reload usbdevice.service"

# 高通 QCS6490 等 mainline dwc3 平台没有 android_usb class，上面的规则永不触发。
# UDC 设备出现/变化时异步 reload usbdevice，作为 gadget bind 的兜底触发
# （与 service 的 WantedBy=usb-gadget.target 互补；usbdevice update 内部
# flock + 幂等守卫，重复触发安全）。
SUBSYSTEM=="udc", ACTION=="add|change", RUN+="/usr/bin/systemctl --no-block reload usbdevice.service"
