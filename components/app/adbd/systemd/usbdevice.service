[Unit]
Description=Manage USB device functions
DefaultDependencies=no
Requires=sys-kernel-config.mount
After=systemd-modules-load.service sys-kernel-config.mount local-fs.target
# 限速 30s 内允许 5 次 restart，给底层 UDC controller、role
# 检测与 FunctionFS daemon 留出就绪时间。超过后不再 burst 重试，
# 便于保留真实的硬件或配置故障现场。
StartLimitBurst=5
StartLimitIntervalSec=30

[Service]
# oneshot + RemainAfterExit：usbdevice 本身是"配置 gadget 并拉起 FunctionFS
# daemon"的一次性动作，脚本跑完就退出，长驻的只有它 spawn 的守护循环。
# 原先的 Type=forking 让 systemd 把那个守护循环误当作 main process 追踪 ——
# 于是服务的"存活"依赖循环永不退出这一 bug。守护循环被正常回收后
# （disconnect recovery 的 adb_stop），systemd 立刻判定服务已退出并执行
# ExecStop，把刚建好的 gadget 又拆掉。
Type=oneshot
RemainAfterExit=yes
Environment=TERM=xterm
Environment=TMPDIR=/tmp
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/sbin/usbdevice start
ExecReload=/usr/sbin/usbdevice update
ExecStop=/usr/sbin/usbdevice stop
# UDC bind 失败时脚本在 "Writing UDC=" 后 read-back 校验
# controller name 并 exit 1。Restart=on-failure 让 role/VBUS/deferred probe 等
# 短暂竞态可自愈；ConfigFS 或 gadget framework 缺失则由脚本单独报错。
Restart=on-failure
RestartSec=2

[Install]
# sysinit.target：保持 Rockchip 等平台的早期启动路径不回归。
# usb-gadget.target：systemd 自带 udev 规则在 UDC 设备就绪时
#   (SUBSYSTEM=="udc", ENV{SYSTEMD_WANTS}+="usb-gadget.target") 拉起此 target。
#   高通 QCS6490 等 mainline dwc3 平台没有 android_usb class、61-usbdevice.rules
#   的 android_usb change 规则永不触发，改靠这条链路在 controller ready 时
#   (重新)启动 gadget，替代失效的 android_usb 自愈机制。两条并存 = 早启 +
#   UDC-ready 兜底重启；usb_start 的"已运行则跳过"守卫保证幂等。
WantedBy=sysinit.target usb-gadget.target
