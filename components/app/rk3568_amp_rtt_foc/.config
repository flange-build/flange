# rk3568_amp_rtt_foc 的 Kconfig 增量片段（构建时按符号合并进 BSP 的 .config）。
#
# 只开 RT_USING_PWM：其唯一作用是触发本 app 补进 hal_conf.h 的
#   #ifdef RT_USING_PWM → #define HAL_PWM_MODULE_ENABLED
# 门控，使 hal_pwm.c 带实现编译，app 得以直接调 HAL_PWM 驱动 PWM3 三相。
# 不需 BSP_USING_PWMxx——本 app 走 HAL 直驱、绕开 drv_pwm 的 RT device 框架
# （drv_pwm 也只实例化 PWM0/1/2、无 PWM3）。
#
# GPIO/PINCTRL 由 BSP 默认的 RT_USING_PIN 提供，无需在此声明。
CONFIG_RT_USING_PWM=y

# I2C：开 RT_USING_I2C 触发 hal_conf.h 的 HAL_I2C 门控，使 hal_i2c.c 带实现编译，
# app 得以经 HAL 直驱 + 轮询读 AS5600 磁编码器（i2c2）。不开 RT_USING_I2C2——那会
# 让 drv_i2c 注册中断驱动的 i2c2 设备、抢 I2C2 中断；本 app 走 HAL 直驱轮询，绕开
# AMP 从核的 GIC 中断路由问题。
CONFIG_RT_USING_I2C=y
