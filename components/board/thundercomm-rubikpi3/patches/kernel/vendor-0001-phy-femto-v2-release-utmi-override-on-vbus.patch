 static int qcom_snps_hsphy_clk_init(struct qcom_snps_hsphy *hsphy)
@@ -235,6 +246,38 @@ static int qcom_snps_hsphy_set_mode(struct phy *phy, enum phy_mode mode,
 	return 0;
 }
 
+/*
+ * Firmware may take over the UTMI datapath and leave the PHY non-driving
+ * after VBUS goes away. Without a Type-C or extcon notification nothing
+ * re-initializes the PHY on reattach, so D+ is never pulled up. Poll VBUS
+ * and hand the datapath back to the controller once it is present again.
+ */
+static void qcom_snps_hsphy_vbus_work(struct work_struct *work)
+{
+	struct qcom_snps_hsphy *hsphy = container_of(to_delayed_work(work),
+					struct qcom_snps_hsphy, vbus_work);
+	int vbus_uv, ret;
+
+	/* Returns an IIO_VAL_* type (positive) on success */
+	ret = iio_read_channel_processed(hsphy->vbus_chan, &vbus_uv);
+	if (ret >= 0 && vbus_uv > VBUS_PRESENT_THRESHOLD_UV &&
+	    hsphy->mode != PHY_MODE_USB_HOST &&
+	    (readl_relaxed(hsphy->base + USB2_PHY_USB_PHY_CFG0) &
+	     UTMI_PHY_DATAPATH_CTRL_OVERRIDE_EN)) {
+		qcom_snps_hsphy_write_mask(hsphy->base,
+					   USB2_PHY_USB_PHY_HS_PHY_CTRL2,
+					   USB2_SUSPEND_N_SEL, 0);
+		qcom_snps_hsphy_write_mask(hsphy->base, USB2_PHY_USB_PHY_CFG0,
+					   UTMI_PHY_DATAPATH_CTRL_OVERRIDE_EN, 0);
+		dev_info(hsphy->dev,
+			 "VBUS present, released UTMI datapath override\n");
+	}
+
+	queue_delayed_work(system_freezable_power_efficient_wq,
+			   &hsphy->vbus_work,
+			   msecs_to_jiffies(VBUS_POLL_INTERVAL_MS));
+}
+
