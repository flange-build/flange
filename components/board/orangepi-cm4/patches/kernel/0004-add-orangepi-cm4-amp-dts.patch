From: flange <flange@localhost>
Subject: [PATCH 4/4] arm64: dts: rockchip: 新增 rk3566-orangepi-cm4-amp.dts

amp / amp-rtt product 专用 dts：基础板 + rk3568-amp.dtsi + 固件区
reserved-memory(amp@7000000) + amp-cpu3 entry=0x07000000 + rpmsg link-id 0x10
+ UART7_M2 从核 console + MBOX0_CH3_A2B 路由 + arm_pmu 去 cpu3 + delete cpu3。

Orange Pi CM4 40pin 未引出当前 tspi-rk3566 AMP demo 使用的 UART4_M1，但引出了
UART7_M2：GPIO4_A2=UART7_TX_M2、GPIO4_A3=UART7_RX_M2，故本板 AMP dts 将
rockchip-amp 的 console clock/pinctrl/IRQ 从 UART4_M1 覆盖为 UART7_M2。

diff --git a/arch/arm64/boot/dts/rockchip/rk3566-orangepi-cm4-amp.dts b/arch/arm64/boot/dts/rockchip/rk3566-orangepi-cm4-amp.dts
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3566-orangepi-cm4-amp.dts
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Orange Pi CM4 AMP product 专用设备树。仅 amp / amp-rtt product 经
+ * kernel.dts 选用，default product 不受影响。在基础板 dts 之上：
+ *   - #include rk3568-amp.dtsi：reserved-memory（SHMEM/rpmsg）、rockchip-amp、
+ *     rpmsg、使能 &mailbox。SHMEM/rpmsg 地址与 RK3566 amp.memory 一致。
+ *   - reserved-memory amp@7000000：保留从核固件代码区。
+ *   - &amp_cpus/amp-cpu3 entry 覆盖为 0x07000000（与固件 load 一致）。
+ *   - &rpmsg：rockchip,link-id 覆盖为 0x10（与从核固件同步，使从核新消息发
+ *     mailbox ch0、命中 stock 驱动 rx 回调，Linux rpmsg 驱动无需 patch）。
+ *   - &rockchip_amp：从核 console 改为 UART7_M2，并追加 rpmsg link-up 邮箱
+ *     中断 MBOX0_CH3_A2B 路由。
+ *   - &arm_pmu：删 cpu3 前去掉对它的 interrupt/affinity（否则 pmu probe 失败）。
+ *   - /delete-node/ &cpu3：把第 4 核摘给 AMP，Linux 跑 3 核。
+ *
+ * AMP 从核 console = UART7_M2（40pin: GPIO4_A2/TX, GPIO4_A3/RX）。
+ * HAL baud rate = 1500000；RT-Thread baud rate = 115200（固件侧决定）。
+ */
+
+#include "rk3566-orangepi-cm4-base.dts"
+#include "rk3568-amp.dtsi"
+
+/* amp-irqs 用的中断号 = GIC INTID（= SPI + 32），取值同 AMP HAL SDK 的 soc.h
+ * IRQn 枚举。dts 无法 #include 固件 soc.h，故在此按 soc.h 命名重述。
+ *   UART7_IRQn         = 155（SPI 123）       AMP 从核 console
+ *   MBOX0_CHn_A2B_IRQn = 219 + n（SPI 187+n）  rpmsg A2B(主→从)邮箱中断 */
+#define UART7_IRQn          155
+#define MBOX0_CH0_A2B_IRQn  219
+#define MBOX0_CH3_A2B_IRQn  (MBOX0_CH0_A2B_IRQn + 3)
+
+/ {
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		amp_firmware_reserved: amp@7000000 {
+			reg = <0x0 0x07000000 0x0 0x00800000>;
+			no-map;
+		};
+	};
+};
+
+&amp_cpus {
+	amp-cpu3 {
+		entry = <0x0 0x07000000>;
+	};
+};
+
+&rpmsg {
+	rockchip,link-id = <0x10>;
+};
+
+/* Orange Pi CM4 40pin 未引出 UART4_M1，改用 UART7_M2：
+ *   GPIO4_A2 = UART7_TX_M2 = 40pin 15
+ *   GPIO4_A3 = UART7_RX_M2 = 40pin 16
+ *
+ * MBOX0_CH3_A2B(INTID 222) = Linux→cpu3 的 rpmsg link-up 邮箱中断，必须列进
+ * amp-irqs，否则 Linux gic_dist_init 把它路由回 cpu0、固件永远收不到。
+ * amp-irqs 属性赋值是整体替换，须包含 console、CPUOFF、TOUCH 与 mailbox。 */
+&rockchip_amp {
+	clocks = <&cru SCLK_UART7>, <&cru PCLK_UART7>,
+		 <&cru PCLK_TIMER>, <&cru CLK_TIMER4>, <&cru CLK_TIMER5>,
+		 <&cru ACLK_MCU>;
+
+	pinctrl-0 = <&uart7m2_xfer>;
+
+	amp-irqs = /bits/ 64 <
+		GIC_AMP_IRQ_CFG_ROUTE(UART7_IRQn, 0xd0, CPU_GET_AFFINITY(3, 0))
+		GIC_AMP_IRQ_CFG_ROUTE(AMP_CPUOFF_REQ_IRQ(3), 0xd0, CPU_GET_AFFINITY(3, 0))
+		GIC_AMP_IRQ_CFG_ROUTE(GIC_TOUCH_REQ_IRQ(3), 0xd0, CPU_GET_AFFINITY(3, 0))
+		GIC_AMP_IRQ_CFG_ROUTE(MBOX0_CH3_A2B_IRQn, 0xd0, CPU_GET_AFFINITY(3, 0))>;
+};
+
+&arm_pmu {
+	interrupts = <GIC_SPI 228 IRQ_TYPE_LEVEL_HIGH>,
+		     <GIC_SPI 229 IRQ_TYPE_LEVEL_HIGH>,
+		     <GIC_SPI 230 IRQ_TYPE_LEVEL_HIGH>;
+	interrupt-affinity = <&cpu0>, <&cpu1>, <&cpu2>;
+};
+
+/delete-node/ &cpu3;
