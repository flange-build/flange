# 支持演示和测试使用的 USB CAN 适配器
#
# 启用 CANable、Candlelight 和 PEAK System PCAN-USB 等常用硬件，
# 分别由 slcan、gs_usb 和 peak_usb 驱动提供支持

# 串口与 USB 串口 CAN 适配器（slcan）
CONFIG_CAN_SLCAN=y
# 兼容 Geschwister Schneider UG 和 candleLight 的接口
CONFIG_CAN_GS_USB=y
# 用于 CAN 2.0b/CAN-FD 的 PEAK PCAN-USB/USB Pro 接口
CONFIG_CAN_PEAK_USB=y
