Subject: [PATCH] 提前保存 UNO Q 前级槽位并传入 Linux 设备树

优先读取 ABL 传入的 DTB，在 live tree 初建时复制槽位，避免 EFI 覆盖 bootargs。
未知、重复及非法值仍拒绝传递，不猜测 A/B。

--- a/arch/arm/mach-snapdragon/of_fixup.c
+++ b/arch/arm/mach-snapdragon/of_fixup.c
@@ -23,6 +23,7 @@
 #include <dm/of.h>
 #include <event.h>
 #include <fdt_support.h>
+#include <init.h>
 #include <linux/errno.h>
 #include <stdlib.h>
 #include <time.h>
@@ -153,10 +154,70 @@
 		debug(#func " took %lluus\n", timer_get_us() - start); \
 	} while (0)
 
+/* EFI 会改写 bootargs；在 live tree 创建时复制已核验槽位，不保留原属性指针。 */
+static char unoq_boot_slot[3];
+
+static void qcom_capture_unoq_boot_slot(struct device_node *root)
+{
+	struct device_node *chosen;
+	const void *external_fdt = (const void *)get_prev_bl_fdt_addr();
+	const char *cmdline, *value;
+	const char android_key[] = "androidboot.slot_suffix=";
+	const char slot_key[] = "slot_suffix=";
+	size_t len, keylen;
+	int size, offset;
+
+	unoq_boot_slot[0] = '\0';
+	if (!of_device_is_compatible(root, "arduino,imola", NULL, NULL))
+		return;
+	/* 内置 control DTB 可能不含 ABL 参数；优先取前级实际交付的 DTB。 */
+	if (external_fdt && !fdt_check_header(external_fdt)) {
+		offset = fdt_path_offset(external_fdt, "/chosen");
+		cmdline = offset >= 0 ?
+			fdt_getprop(external_fdt, offset, "bootargs", &size) : NULL;
+	} else {
+		chosen = of_find_node_opts_by_path(root, "/chosen", NULL);
+		cmdline = chosen ? of_get_property(chosen, "bootargs", &size) : NULL;
+	}
+	if (!cmdline || size <= 0 || !memchr(cmdline, '\0', size)) {
+		printf("UNO Q: 前级未提供有效 bootargs，槽位未知\n");
+		return;
+	}
+	while (*cmdline) {
+		cmdline += strspn(cmdline, " \t");
+		len = strcspn(cmdline, " \t");
+		if (!len)
+			break;
+		keylen = 0;
+		if (len >= sizeof(android_key) - 1 &&
+		    !strncmp(cmdline, android_key, sizeof(android_key) - 1))
+			keylen = sizeof(android_key) - 1;
+		else if (len >= sizeof(slot_key) - 1 &&
+			 !strncmp(cmdline, slot_key, sizeof(slot_key) - 1))
+			keylen = sizeof(slot_key) - 1;
+		if (keylen) {
+			value = cmdline + keylen;
+			if (unoq_boot_slot[0] || len != keylen + 2 || value[0] != '_' ||
+			    (value[1] != 'a' && value[1] != 'b')) {
+				unoq_boot_slot[0] = '\0';
+				printf("UNO Q: 前级槽位重复或非法，拒绝传递\n");
+				return;
+			}
+			unoq_boot_slot[0] = value[0];
+			unoq_boot_slot[1] = value[1];
+			unoq_boot_slot[2] = '\0';
+		}
+		cmdline += len;
+	}
+	printf("UNO Q: 已捕获前级启动槽位 %s\n",
+	       unoq_boot_slot[0] ? unoq_boot_slot : "unknown");
+}
+
 static int qcom_of_fixup_nodes(void * __maybe_unused ctx, struct event *event)
 {
 	struct device_node *root = event->data.of_live_built.root;
 
+	qcom_capture_unoq_boot_slot(root);
 	time_call(fixup_usb_nodes, root);
 	time_call(fixup_power_domains, root);
 
@@ -284,7 +345,19 @@
 
 int ft_board_setup(void __maybe_unused *blob, struct bd_info __maybe_unused *bd)
 {
+	int chosen;
+
 	qcom_fixup_addrs(blob);
-
-	return 0;
-}
+	if (fdt_node_check_compatible(blob, 0, "arduino,imola"))
+		return 0;
+	chosen = fdt_path_offset(blob, "/chosen");
+	if (chosen < 0)
+		chosen = fdt_add_subnode(blob, 0, "chosen");
+	if (chosen < 0)
+		return chosen;
+	/* 外部 DTB 不能自行指定槽位，也不能从当前 GPT 优先级猜测。 */
+	fdt_delprop(blob, chosen, "arduino,boot-slot");
+	if (!unoq_boot_slot[0])
+		return 0;
+	return fdt_setprop_string(blob, chosen, "arduino,boot-slot", unoq_boot_slot);
+}
