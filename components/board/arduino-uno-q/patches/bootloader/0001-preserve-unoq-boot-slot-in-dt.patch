Subject: [PATCH] 重定位前保存 UNO Q 前级槽位并传入 Linux 设备树

ABL 把命令行写入它交给 U-Boot 的 DTB /chosen/bootargs；该 DTB 位于 ABL 内存，
U-Boot 重定位后可能已被覆盖，因此在 board_fdt_blob_setup 中解析，结果存于 .data。
兼容 systemd.setenv="SLOT_SUFFIX=_x" 与 Android 两种写法；未知、冲突及非法值拒绝传递。
实板证据：官方 251020 ABL 的 bootargs 不含槽位，此时写入 status=no-slot，由 Linux
mark-boot-success 按 GPT 唯一可启动槽位判定。另写 arduino,boot-slot-status 与
arduino,abl-bootargs 供 Linux 诊断。

--- a/arch/arm/mach-snapdragon/board.c
+++ b/arch/arm/mach-snapdragon/board.c
@@ -241,10 +241,13 @@
 		panic("No valid memory ranges found!\n");
 
 	/* If we have an external FDT, it can only have come from the Android bootloader. */
-	if (external_valid)
+	if (external_valid) {
 		qcom_boot_source = QCOM_BOOT_SOURCE_ANDROID;
-	else
+		/* ABL 的 DTB 在重定位后可能被覆盖，UNO Q 槽位必须此时解析。 */
+		qcom_capture_unoq_boot_slot(external_fdt);
+	} else {
 		qcom_boot_source = QCOM_BOOT_SOURCE_XBL;
+	}
 
 	debug("ram_base = %#011lx, ram_size = %#011llx\n",
 	      gd->ram_base, gd->ram_size);
--- a/arch/arm/mach-snapdragon/of_fixup.c
+++ b/arch/arm/mach-snapdragon/of_fixup.c
@@ -282,9 +282,141 @@
 	return 0;
 }
 
+/*
+ * UNO Q 启动槽位：ABL 把命令行写入它交给 U-Boot 的 DTB /chosen/bootargs。
+ * 该 DTB 位于 ABL 内存中，U-Boot 重定位后可能已被覆盖，因此必须在
+ * board_fdt_blob_setup（重定位前）解析。重定位前 .bss 不可用，结果只存于 .data。
+ * 状态：u=未执行 n=无 bootargs m=无槽位 x=冲突或非法 k=已捕获。
+ */
+static char unoq_boot_slot[3] __attribute__((section(".data"))) = "";
+static char unoq_boot_slot_status __attribute__((section(".data"))) = 'u';
+/* ABL 原始 bootargs 副本（截断），供 Linux 诊断槽位参数格式。 */
+static char unoq_abl_bootargs[512] __attribute__((section(".data"))) = "";
+
+/*
+ * 解析单个 bootargs 词元。返回 1 表示携带槽位并写入 *value，0 表示无关，-1 表示非法。
+ * 兼容 systemd.setenv="SLOT_SUFFIX=_x" 与 Android 两种写法（实板官方 ABL 不下发槽位）。
+ */
+static int qcom_unoq_slot_token(const char *tok, size_t len, const char **value)
+{
+	const char android_key[] = "androidboot.slot_suffix=";
+	const char slot_key[] = "slot_suffix=";
+	const char setenv_key[] = "systemd.setenv=";
+	const char env_key[] = "SLOT_SUFFIX=";
+	size_t keylen;
+
+	if (len >= sizeof(android_key) - 1 &&
+	    !strncmp(tok, android_key, sizeof(android_key) - 1)) {
+		keylen = sizeof(android_key) - 1;
+	} else if (len >= sizeof(slot_key) - 1 &&
+		   !strncmp(tok, slot_key, sizeof(slot_key) - 1)) {
+		keylen = sizeof(slot_key) - 1;
+	} else if (len >= sizeof(setenv_key) - 1 &&
+		   !strncmp(tok, setenv_key, sizeof(setenv_key) - 1)) {
+		tok += sizeof(setenv_key) - 1;
+		len -= sizeof(setenv_key) - 1;
+		/* 只剥离成对引号；不成对的引号不会被识别为槽位，结果为未知或非法。 */
+		if (len >= 2 && tok[0] == '"' && tok[len - 1] == '"') {
+			tok++;
+			len -= 2;
+		}
+		/* 其他 systemd 环境变量与槽位无关。 */
+		if (len < sizeof(env_key) - 1 ||
+		    strncmp(tok, env_key, sizeof(env_key) - 1))
+			return 0;
+		keylen = sizeof(env_key) - 1;
+	} else {
+		return 0;
+	}
+	tok += keylen;
+	len -= keylen;
+	if (len != 2 || tok[0] != '_' || (tok[1] != 'a' && tok[1] != 'b'))
+		return -1;
+	*value = tok;
+	return 1;
+}
+
+/* 重定位前调用，不打印、不分配内存，只读 ABL DTB 并写 .data。 */
+void qcom_capture_unoq_boot_slot(const void *fdt)
+{
+	const char *cmdline, *value;
+	size_t len;
+	int size, offset, ret;
+	char slot = 0;
+
+	unoq_boot_slot[0] = '\0';
+	if (!fdt || fdt_node_check_compatible(fdt, 0, "arduino,imola"))
+		return;
+	offset = fdt_path_offset(fdt, "/chosen");
+	cmdline = offset >= 0 ? fdt_getprop(fdt, offset, "bootargs", &size) : NULL;
+	if (!cmdline || size <= 0 || !memchr(cmdline, '\0', size)) {
+		unoq_boot_slot_status = 'n';
+		return;
+	}
+	len = strlen(cmdline);
+	if (len >= sizeof(unoq_abl_bootargs))
+		len = sizeof(unoq_abl_bootargs) - 1;
+	memcpy(unoq_abl_bootargs, cmdline, len);
+	unoq_abl_bootargs[len] = '\0';
+	while (*cmdline) {
+		cmdline += strspn(cmdline, " \t");
+		len = strcspn(cmdline, " \t");
+		if (!len)
+			break;
+		ret = qcom_unoq_slot_token(cmdline, len, &value);
+		/* 多种写法给出相同槽位可以接受；非法或互相冲突一律拒绝。 */
+		if (ret < 0 || (ret > 0 && slot && slot != value[1])) {
+			unoq_boot_slot_status = 'x';
+			return;
+		}
+		if (ret > 0)
+			slot = value[1];
+		cmdline += len;
+	}
+	if (!slot) {
+		unoq_boot_slot_status = 'm';
+		return;
+	}
+	unoq_boot_slot[0] = '_';
+	unoq_boot_slot[1] = slot;
+	unoq_boot_slot[2] = '\0';
+	unoq_boot_slot_status = 'k';
+}
+
+static int qcom_fixup_unoq_boot_slot(void *blob)
+{
+	static const char *const names[] = {
+		"not-run", "no-bootargs", "no-slot", "invalid", "captured",
+	};
+	const char *codes = "unmxk";
+	const char *status = "unknown";
+	int chosen, i;
+
+	if (fdt_node_check_compatible(blob, 0, "arduino,imola"))
+		return 0;
+	for (i = 0; codes[i]; i++)
+		if (codes[i] == unoq_boot_slot_status)
+			status = names[i];
+	printf("UNO Q: 前级启动槽位 %s（%s）\n",
+	       unoq_boot_slot[0] ? unoq_boot_slot : "unknown", status);
+	chosen = fdt_path_offset(blob, "/chosen");
+	if (chosen < 0)
+		chosen = fdt_add_subnode(blob, 0, "chosen");
+	if (chosen < 0)
+		return chosen;
+	/* 外部 DTB 不能自行指定槽位，也不能从当前 GPT 优先级猜测。 */
+	fdt_delprop(blob, chosen, "arduino,boot-slot");
+	fdt_setprop_string(blob, chosen, "arduino,boot-slot-status", status);
+	if (unoq_abl_bootargs[0])
+		fdt_setprop_string(blob, chosen, "arduino,abl-bootargs", unoq_abl_bootargs);
+	if (!unoq_boot_slot[0])
+		return 0;
+	return fdt_setprop_string(blob, chosen, "arduino,boot-slot", unoq_boot_slot);
+}
+
 int ft_board_setup(void __maybe_unused *blob, struct bd_info __maybe_unused *bd)
 {
 	qcom_fixup_addrs(blob);
 
-	return 0;
+	return qcom_fixup_unoq_boot_slot(blob);
 }
--- a/arch/arm/mach-snapdragon/qcom-priv.h
+++ b/arch/arm/mach-snapdragon/qcom-priv.h
@@ -17,6 +17,9 @@
 
 extern enum qcom_boot_source qcom_boot_source;
 
+/* UNO Q：重定位前从 ABL DTB 解析启动槽位，供 ft_board_setup 传给 Linux。 */
+void qcom_capture_unoq_boot_slot(const void *fdt);
+
 #if IS_ENABLED(CONFIG_EFI_HAVE_CAPSULE_SUPPORT)
 void qcom_configure_capsule_updates(void);
 #else
