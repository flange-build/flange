# Bootloader 构建 — 顶层 alias + select() 路由

load("//build:bootloader_collect.bzl", "bootloader_collect")

alias(
    name = "bootloader",
    actual = select(
        {
            "//build:platform_rockchip": "//bootloader/rockchip",
        },
        no_match_error = "未指定目标平台，请使用 --config=<board> 指定板级配置（如 --config=radxa-zero3w）",
    ),
    visibility = ["//visibility:public"],
)

bootloader_collect(
    name = "collect",
    bootloader = ":bootloader",
)
