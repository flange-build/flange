# Rockchip 平台 Bootloader 构建

load("//build:bootloader_build.bzl", "bootloader_build")

filegroup(
    name = "patches",
    srcs = glob(["patches/**/*.patch"], allow_empty = True),
    visibility = ["//visibility:public"],
)

bootloader_build(
    name = "rockchip",
    build_script = "build.sh",
    bootloader_src = select({
        "//build:board_radxa_zero3w": "@bootloader_src_radxa_zero3w//:src",
        "//build:board_neons_core3566_nanob": "@bootloader_src_neons_core3566_nanob//:src",
    }),
    firmware_src = "@rkbin_rockchip//:src",
    defconfig = select({
        "//build:board_radxa_zero3w": "rk3568_defconfig",
        "//build:board_neons_core3566_nanob": "rk3568_defconfig",
    }),
    ini_prefix = select({
        "//build:board_radxa_zero3w": "RK3566",
        "//build:board_neons_core3566_nanob": "RK3566",
    }),
    trust_ini_prefix = select({
        "//build:board_radxa_zero3w": "RK3568",
        "//build:board_neons_core3566_nanob": "RK3568",
    }),
    jobs = 0,
    platform_patches = [":patches"],
    board_patches = select({
        "//build:board_radxa_zero3w": ["//board/radxa-zero3w:bootloader_patches"],
        "//build:board_neons_core3566_nanob": ["//board/neons-core3566-nanob:bootloader_patches"],
    }),
    visibility = ["//visibility:public"],
)
