# 镜像打包 — 顶层 alias + select() 路由

alias(
    name = "image",
    actual = select(
        {
            "//build:platform_rockchip": "//image/rockchip",
        },
        no_match_error = "未指定目标平台，请使用 --config=<board> 指定板级配置（如 --config=radxa-zero3w）",
    ),
    visibility = ["//visibility:public"],
)

alias(
    name = "collect",
    actual = select(
        {
            "//build:platform_rockchip": "//image/rockchip:collect",
        },
        no_match_error = "未指定目标平台，请使用 --config=<board> 指定板级配置（如 --config=radxa-zero3w）",
    ),
)
